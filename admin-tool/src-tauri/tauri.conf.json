{
  "productName": "Quiz Admin",
  "version": "0.1.0",
  "identifier": "com.alakin66.quizadmin",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node serve-dev.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quiz Admin",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
